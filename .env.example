# Copy to .env and replace the placeholder. Never commit .env.
POSTGRES_USER=queueforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=queueforge

# Used by the API when run outside Docker (e.g. local tests). Inside Compose the
# URL is assembled from the values above.
DATABASE_URL=postgresql+psycopg://queueforge:change-me@127.0.0.1:5432/queueforge
# Integration tests use a SEPARATE database (name must end in _test); they wipe its tables.
TEST_DATABASE_URL=postgresql+psycopg://queueforge:change-me@127.0.0.1:5432/queueforge_test
LOG_LEVEL=INFO

# Rate limiting only (never stores jobs). If unset, rate limiting is off.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=65536
# Integration tests (a separate Redis database number keeps them away from dev data).
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Production switch: "production" hides the API docs and rejects weak database passwords.
ENVIRONMENT=development
# Backpressure: most jobs allowed to wait in the queue (submits over the limit are refused).
MAX_QUEUED_JOBS_PER_CLIENT=10000
MAX_QUEUED_JOBS_TOTAL=100000
# On shutdown a worker lets its current job finish for this long, then hands it back.
WORKER_SHUTDOWN_DRAIN_SECONDS=25
# How long the "is the whole queue full?" answer and /metrics results may be reused (seconds).
QUEUE_DEPTH_CACHE_SECONDS=1
METRICS_CACHE_SECONDS=10
# Fair claiming: serve the client with the fewest running jobs first (false = oldest-first overall).
FAIR_CLAIMING=true
FAIR_CLAIM_MAX_CLIENTS=64
# Retention: how long FINISHED jobs are kept before the maintenance process deletes them.
RETENTION_SUCCEEDED_DAYS=7
RETENTION_FAILED_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
# Backups: how many to keep, and an optional passphrase that encrypts them (keep it somewhere SAFE and
# separate: without it an encrypted backup cannot be restored).
BACKUP_KEEP=7
BACKUP_PASSPHRASE=
